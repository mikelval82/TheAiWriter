{
  "name": "theaiwriter",
  "version": "0.5.3",
  "description": "Escribe documentos científicos consultando los PDF de tu Zotero y verifica que cada cita dice lo que dice el paper",
  "author": {
    "name": "mikelval82"
  },
  "repository": "https://github.com/mikelval82/TheAiWriter",
  "license": "MIT",
  "mcpServers": {
    "theaiwriter": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "--frozen",
        "--no-dev",
        "--quiet",
        "theaiwriter-mcp"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/entorno"
      }
    }
  }
}
