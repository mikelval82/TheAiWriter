# No API key is needed. The judge uses the selected CLI's logged-in account.
# Claude plans and writes in the Claude Code session; these settings configure the judge.
LLM_BACKEND=claude-code
DEFAULT_MODEL=sonnet
# CLAUDE_BIN=claude
# CODEX_BIN=codex
# CODEX_EFFORT=low
LLM_TIMEOUT=600
LLM_MAX_RETRIES=2

# Local passage embeddings. The model is downloaded on first use.
# Changing the model rebuilds the passage index on its next update.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# EMBEDDING_CACHE_DIR=/path/to/modelos

# Optional overrides for the Zotero data folder and the passage index.
# THEAIWRITER_ZOTERO=/path/to/Zotero
# THEAIWRITER_INDICE=/path/to/indice
