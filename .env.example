# No API key is needed by default: text is generated with the Claude Code CLI
# (run `claude` and /login once) and embeddings are computed locally.

# Text generation backend: "claude-code" (default) or "openai"
LLM_BACKEND=claude-code
# Path to the Claude Code CLI, if it is not on PATH
# CLAUDE_BIN=claude

# Models (defaults for claude-code; with openai they default to gpt-5.2)
DEFAULT_MODEL=sonnet
REASONING_MODEL=opus
FAST_MODEL=haiku

# Embedding backend: "local" (default, sentence-transformers) or "openai"
EMBEDDING_BACKEND=local
# Small multilingual model by default; BAAI/bge-m3 is larger and slower.
# Run `ai-writer reindex` after changing it.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Only needed with LLM_BACKEND=openai or EMBEDDING_BACKEND=openai
# OPENAI_API_KEY=your-openai-api-key-here

# Seconds to wait for one generation call, and retries after a transient failure
LLM_TIMEOUT=600
LLM_MAX_RETRIES=2

# Only used by the openai backend
MAX_TOKENS=16384
TEMPERATURE=0.0
